---

generic:
  role_description: |
    Install NFS server/client versions v3/v4

# Supported platforms
platforms:
  centos7:
    supported: true
    ci: false
  sles15:
    supported: true
    ci: false
  sles16:
    supported: true
    ci: false
  debian11:
    supported: true
    ci: false
  debian12:
    supported: true
    ci: false
  ubuntu1804:
    supported: true
    ci: false
  ubuntu2004:
    supported: true
    ci: false
  ubuntu2204:
    supported: true
    ci: false

# Molecule
molecule:
  driver: docker
  nodes:
    - name: server
      groups: ['nfs_servers']
      volumes:
        - /export/test:/export/test:rw
      interfaces:
        - network_name: private_network
          ip: 192.168.56.100
    - name: client
      groups: ['nfs_clients']
      interfaces:
        - network_name: private_network
          ip: 192.168.56.101
  prepare:
    vars:
      prepare_firewall: true
      register_hosts: true

ci_templates:
  converge.yml:
    force: false
